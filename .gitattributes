# Normalize line endings in the repo; check out per-platform convention.
* text=auto

*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.py        text eol=lf

# Never touch these.
pnpm-lock.yaml binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.otf       binary
*.ttf       binary

# Byte-exact test fixtures: read (and one hashed) as bytes by the tests, so a
# per-platform EOL conversion would turn the suite red on Windows and change the
# pinned SHA-256. Checked in as LF, restored as LF on every platform.
packages/pdf-fonts/test/fixtures/emoji-test-17.0.txt text eol=lf
packages/pdf-fonts/test/fixtures/bidi-character-test-13.0.0-slice.txt text eol=lf

# Golden prompts: compared byte for byte with what the server builds.
packages/mcp-server/test/golden/*.txt text eol=lf
