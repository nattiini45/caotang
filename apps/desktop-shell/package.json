{
  "name": "@caotang/desktop-shell",
  "productName": "Caotang for desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "start": "pnpm build && install-electron && electron .",
    "test:smoke": "pnpm build && install-electron && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@caotang/artifact-fs-node": "workspace:*",
    "@caotang/store": "workspace:*"
  },
  "devDependencies": {
    "electron": "45.4.1"
  }
}
