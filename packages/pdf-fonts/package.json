{
  "name": "@caotang/pdf-fonts",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "What both PDFs share for their fallback fonts — byte checks, loaders, fontkit helpers, the CID-font writer, the emoji classifier, the bidi and shaping modules for Arabic and Hebrew, the Brahmic units and the Indic shaper for Devanagari, and the coverage tables, and the common fonts' tables (`@caotang/pdf-fonts/common`)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bidi": "./src/bidi.ts",
    "./common": "./src/common.ts",
    "./shaper": "./src/shaper.ts",
    "./node-loader": "./src/node-loader.ts",
    "./indic-shaper": "./src/indic-shaper.ts"
  },
  "dependencies": {
    "@caotang/font-noto-arabic": "workspace:*",
    "@caotang/font-noto-cjk": "workspace:*",
    "@caotang/font-noto-devanagari": "workspace:*",
    "@caotang/font-noto-emoji": "workspace:*",
    "@caotang/font-noto-hebrew": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "bidi-js": "1.1.0",
    "fflate": "0.8.3",
    "fontkit": "2.0.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "harfbuzzjs": "1.6.3"
  }
}
