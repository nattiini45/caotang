{
  "name": "@caotang/pdf-fonts",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "What both PDFs share for their fallback fonts — byte checks, loaders, fontkit helpers, the CID-font writer, the emoji classifier and the coverage tables",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node-loader": "./src/node-loader.ts"
  },
  "dependencies": {
    "@caotang/font-noto-arabic": "workspace:*",
    "@caotang/font-noto-cjk": "workspace:*",
    "@caotang/font-noto-emoji": "workspace:*",
    "@caotang/font-noto-hebrew": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "bidi-js": "1.1.0",
    "fflate": "0.8.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
