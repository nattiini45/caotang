{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is here for `lib.dom`'s types only: this package type-checks `@caotang/store`, whose sources reference IndexedDB
    // interfaces, as `packages/coherence` does. Nothing here runs in a browser.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
