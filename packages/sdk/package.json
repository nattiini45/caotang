{
  "name": "@caotang/sdk",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Run Caotang's agent from a Node script, a CLI or CI: open a project folder, run an intent under an approval policy, read the diff (agent-harness.md §11)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./folder": "./src/folder-api.ts"
  },
  "dependencies": {
    "@caotang/bus": "workspace:*",
    "@caotang/coherence": "workspace:*",
    "@caotang/exporter": "workspace:*",
    "@caotang/gateway": "workspace:*",
    "@caotang/harness": "workspace:*",
    "@caotang/ids": "workspace:*",
    "@caotang/pdf-fonts": "workspace:*",
    "@caotang/pictures": "workspace:*",
    "@caotang/store": "workspace:*",
    "@caotang/timeline": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
