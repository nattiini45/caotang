{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is here because the store's source, which this package compiles through, is typed against
    // `lib.dom`'s IndexedDB interfaces. This package touches no DOM at runtime.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
