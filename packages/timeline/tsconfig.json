{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is here only for the IndexedDB types that @caotang/store's public index re-exports.
    // Types only; nothing in this package touches a DOM, and a test asserts it.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
